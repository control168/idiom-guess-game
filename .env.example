# Copy to .env and adjust as needed.
# Local dev (matches docker-compose.yml):
DATABASE_URL="postgresql://postgres:dev@localhost:5432/idiom_dev?schema=public"

# Secret used to sign user auth tokens (HMAC-SHA256). MUST be a long random string in prod.
# Generate one with: `openssl rand -base64 48`
SCORING_SECRET="dev-only-do-not-use-in-prod"

# Cloud Run / Cloud SQL (set via `gcloud run deploy --update-secrets` — do not commit prod values):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# SCORING_SECRET=<from-secret-manager:idiom-scoring-secret>

